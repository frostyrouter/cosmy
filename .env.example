HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
ROUTER_ENV=development
# Production fails closed unless credentials are configured or ALLOW_UNAUTHENTICATED=true is explicit.
# Preferred: JSON array of tenant-scoped SHA-256 key digests. Never store plaintext keys here.
# Scopes: responses:create, admin:read, admin:write, metrics:read. Use separate least-privilege keys.
# COSMY_API_CREDENTIALS=[{"id":"project-a","tenantId":"tenant-a","keySha256":"<64 lowercase hex>","scopes":["responses:create"]}]
# Legacy single plaintext key (tenant `default`); supported for migration only.
# COSMY_API_KEY=change-me
# ALLOW_UNAUTHENTICATED=false
REQUEST_TIMEOUT_MS=60000
PROVIDER_MAX_RETRIES=2
PERSISTENCE_MODE=memory
DATABASE_URL=postgresql://cosmy:cosmy@localhost:5432/cosmy
CACHE_MODE=off
RESPONSE_CACHE_TTL_SECONDS=60
# Completed idempotent responses are replayable for this many seconds.
IDEMPOTENCY_TTL_SECONDS=86400
# Unreconciled reservations are conservatively charged after their renewable lease expires.
RESERVATION_LEASE_SECONDS=300
RECONCILIATION_SWEEP_SECONDS=30
# PostgreSQL registry polling interval across router instances; 0 disables polling.
REGISTRY_REFRESH_SECONDS=15
# Per-tenant budget cap in USD applied to every tenant when PERSISTENCE_MODE=memory (default 0 = unlimited).
TENANT_BUDGET_USD=0
# Maximum requests per IP per minute; 0 disables rate limiting.
# RATE_LIMIT_MAX=0
# Configure a provider by setting both its API key and model.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=
# DeepSeek V4 Flash classifies automatic routing requests before model selection.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_CLASSIFIER_MODEL=deepseek-v4-flash
# CLASSIFIER_MODE=degrade
# CLASSIFIER_TIMEOUT_MS=3000
# CLASSIFIER_MAX_INPUT_CHARS=200000
