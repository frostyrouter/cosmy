HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
ROUTER_ENV=development
REQUEST_TIMEOUT_MS=60000
PROVIDER_MAX_RETRIES=2
PERSISTENCE_MODE=memory
DATABASE_URL=postgresql://cosmy:cosmy@localhost:5432/cosmy
CACHE_MODE=off
RESPONSE_CACHE_TTL_SECONDS=60
# Per-tenant budget cap in USD applied to every tenant when PERSISTENCE_MODE=memory (default 0 = unlimited).
TENANT_BUDGET_USD=0
# Configure a provider by setting both its API key and model.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=
