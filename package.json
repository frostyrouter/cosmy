{
  "name": "cosmy-router",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-neutral adaptive model router",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run --testTimeout=15000",
    "test:watch": "vitest",
    "integration:smoke": "node scripts/integration-smoke.mjs",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/rate-limit": "^10.1.0",
    "fastify": "^5.2.1",
    "pg": "^8.22.0",
    "pino": "^9.6.0",
    "redis": "^6.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "^8.21.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
